server {
    listen 80;
    server_name localhost;
    client_max_body_size 6m;

    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_set_header Host ${BACKEND_HOST};
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # PWA: el Service Worker, su lista de archivos y el index se revisan en cada visita; si se
    # cachearan, el navegador seguiría con la versión vieja de la web después de un deploy
    location ~ ^/(ngsw-worker\.js|ngsw\.json|safety-worker\.js|worker-basic\.min\.js|index\.html)$ {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-cache";
    }

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }
}
