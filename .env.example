# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el .env real al repositorio (ya está en .gitignore).

# --- Base de datos (Supabase Postgres) ---
# La consigues en: Supabase > tu proyecto > Project Settings > Database > Connection string (URI)
# Usa el modo "Transaction" (puerto 6543) para el backend en producción/serverless,
# y el modo "Session" (puerto 5432) si corres el backend localmente sin pooler.
DATABASE_URL=postgresql://postgres:[TU-PASSWORD]@[TU-PROYECTO].supabase.co:5432/postgres

# --- Supabase API (si el backend usa el SDK de Supabase además de SQL directo) ---
SUPABASE_URL=https://[TU-PROYECTO].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Backend FastAPI ---
JWT_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ENVIRONMENT=development

# --- Pasarela de pago (completar cuando se integre) ---
PAYMENT_GATEWAY_API_KEY=

# --- Stripe (pagos con tarjeta, modo test) ---
# Clave secreta: Dashboard de Stripe > Desarrolladores > Claves de API > Clave secreta (sk_test_...)
STRIPE_SECRET_KEY=
# Clave del webhook: Dashboard de Stripe > Desarrolladores > Webhooks > tu endpoint > Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# --- IA (completar cuando se integre) ---
AI_API_KEY=

# --- IA: 3 proveedores gratuitos distintos, uno por función, para no agotar la cuota de uno solo ---
# Gemini (CU-28, recomendaciones): clave en aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Groq (CU-29, chatbot): clave en console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Mistral (CU-30, reportes por IA): clave en console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# --- Vestidor virtual / Try-On con IA (CU-14) ---
# Token de Replicate: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
TRYON_REPLICATE_MODEL=prunaai/p-image-try-on

# --- Notificaciones push (Firebase Cloud Messaging, solo app móvil) ---
# JSON de la cuenta de servicio, en una sola línea: Firebase Console > Configuración
# del proyecto > Cuentas de servicio > Generar nueva clave privada.
FIREBASE_CREDENTIALS_JSON=
