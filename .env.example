# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el .env real al repositorio (ya está en .gitignore).

# --- Base de datos (Supabase Postgres) ---
# La consigues en: Supabase > tu proyecto > Project Settings > Database > Connection string (URI)
# Usa el modo "Transaction" (puerto 6543) para el backend en producción/serverless,
# y el modo "Session" (puerto 5432) si corres el backend localmente sin pooler.
DATABASE_URL=postgresql://postgres:[TU-PASSWORD]@[TU-PROYECTO].supabase.co:5432/postgres

# --- Supabase API (si el backend usa el SDK de Supabase además de SQL directo) ---
SUPABASE_URL=https://[TU-PROYECTO].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Backend FastAPI ---
JWT_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ENVIRONMENT=development

# --- Pasarela de pago (completar cuando se integre) ---
PAYMENT_GATEWAY_API_KEY=

# --- IA (completar cuando se integre) ---
AI_API_KEY=
